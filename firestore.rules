rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function organizer(){return signedIn() && request.auth.uid == "clRiN0j1GThtUex7zPf48dRwGMo1";}
  match /pushTokens/{playerId} {
   allow read: if organizer() || (signedIn() && request.auth.uid == playerId);
   allow create, update: if signedIn() && request.auth.uid == playerId
     && request.resource.data.keys().hasOnly(["token","updatedAt"])
     && request.resource.data.token is string
     && request.resource.data.token.size() <= 4096
     && request.resource.data.updatedAt is number;
   allow delete: if organizer() || (signedIn() && request.auth.uid == playerId);
  }
  match /players/{playerId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.auth.uid == playerId
     && request.resource.data.keys().hasOnly(['name','score','challenge'])
     && request.resource.data.score == 0
     && request.resource.data.challenge == null
     && request.resource.data.name is string
     && request.resource.data.name.size() <= 24;
   allow update: if organizer() || (
      signedIn() && request.auth.uid != playerId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["challenge"])
      && request.resource.data.challenge is map
      && request.resource.data.challenge.kind == "normal"
      && request.resource.data.challenge.senderUid == request.auth.uid
      && request.resource.data.challenge.nonce is string
      && request.resource.data.challenge.title is string
      && request.resource.data.challenge.text is string
      && exists(/databases/$(database)/documents/players/$(request.auth.uid))
    ) || (
      signedIn() && request.auth.uid == playerId
      && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','score','challenge'])
      && request.resource.data.score is number
      && request.resource.data.score >= resource.data.score
      && request.resource.data.score <= resource.data.score + 10
    );
   allow delete: if organizer();
  }
 }
}