rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function organizer(){return signedIn() && request.auth.uid == "clRiN0j1GThtUex7zPf48dRwGMo1";}
  match /players/{playerId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.auth.uid == playerId
     && request.resource.data.keys().hasOnly(['name','score','challenge'])
     && request.resource.data.score == 0
     && request.resource.data.challenge == null
     && request.resource.data.name is string
     && request.resource.data.name.size() <= 24;
   allow update: if organizer() || (
      signedIn() && request.auth.uid == playerId
      && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name','score','challenge'])
      && request.resource.data.score is number
      && request.resource.data.score >= resource.data.score
      && request.resource.data.score <= resource.data.score + 10
    );
   allow delete: if organizer();
  }
 }
}