rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /pyramideRooms/{roomId} {
   allow read: if request.auth != null && exists(/databases/$(database)/documents/pyramideRooms/$(roomId)/members/$(request.auth.uid));
   allow write: if false;
   match /members/{uid} {
    allow read: if request.auth != null && exists(/databases/$(database)/documents/pyramideRooms/$(roomId)/members/$(request.auth.uid));
    allow write: if false;
   }
   match /hands/{uid} {
    allow read: if request.auth != null && request.auth.uid == uid;
    allow write: if false;
   }
  }
  match /pyramidePrivate/{roomId} { allow read, write: if false; }
 }
}